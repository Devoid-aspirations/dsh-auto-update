# --- 依赖 ---
node_modules/
package-lock.json.bak

# --- 构建 / 打包产物 ---
dist/
build/
out/
*.tgz
*.asar

# --- 编辑器 / IDE / 系统 ---
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini

# --- 环境变量与密钥 ---
.env
.env.*
*.key
*.pem

# --- 日志与临时文件 ---
*.log
*.tmp
*.bak
.tmp/

# ============================================================
# 注意：本项目的 test/ 与 scripts/ 是源码，必须提交。
