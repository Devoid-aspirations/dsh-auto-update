{
  "name": "dsh-auto-update",
  "version": "0.1.5",
  "description": "DeepSeek Harness 自动更新插件：自动检测 @deepseek-ai/dsh 新版本，在空闲窗口无人值守完成全局安装、自重启与健康检查，失败自动回滚，并把打包的桌面端（dsh-desktop）一并同步。 · Unattended self-update for DeepSeek Harness, desktop wrapper included.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "auto-update",
    "self-update"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
